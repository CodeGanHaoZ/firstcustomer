# 数据库。本机开发用 npm run db:dev 启动嵌入式 Postgres，地址就是下面这个。
DATABASE_URL=postgres://firstcustomer:firstcustomer@127.0.0.1:54329/firstcustomer

# 首客内部账号，与客户注册账号独立。所有环境都需要账号和密码。
ADMIN_USERNAME=hifirst
ADMIN_PASSWORD=
# SESSION_SECRET 至少 32 个字符，可用 openssl rand -base64 32 生成。
SESSION_SECRET=

# 选填：用于检查、演示的 Pro 开通密钥（32–256 字符，独立于管理员密码和模型 Key）。
# 用 openssl rand -hex 32 生成；留空关闭新开通，不影响已开通项目。
PRO_ACCESS_KEY=

# 支付服务端模式。simulated 跑通报价、校验和项目开通，不发生扣款或写入真实收款。
# 客户页面使用正常购买流程；仅后台标明模式。生产未显式配置时关闭支付。
PAYMENT_MODE=simulated
# Pro 项目计价：人民币分。标准单产品、单市场、三轮服务底价 99 元，实时调用、按增量预算估算。
PRO_MIN_PRICE_FEN=9900
PRO_MARKUP_PERCENT=200
PRO_INFRA_FEN=500
# 获客、异常处理与维护的内部预算准备金，不是逐单人工审批费或实际支出。
PRO_RESERVE_FEN=4000

# 客户账号。没有独立密钥时沿用 SESSION_SECRET。自定义线上域名可通过 BETTER_AUTH_URL 指定。
# BETTER_AUTH_SECRET=
# 多个正式域名时填写本站额外别名（逗号分隔主机名）；不设置固定 BETTER_AUTH_URL。
# BETTER_AUTH_ALLOWED_HOSTS=
# BETTER_AUTH_URL=https://your-domain.example

# 模型。拿到 Key 后填 MIMO_API_KEY；没有 Key 时用模拟模型跑通流程。
MIMO_API_KEY=
# LLM_PROVIDER=stub
# ALLOW_STUB=1

# 临时改用 StepFun 时设 LLM_PROVIDER=stepfun，走 Step Plan 地址，Key 读 STEPFUN_API_KEY（可以放在终端环境变量里）。
# 模型可以按需覆盖。联网搜索只在 MiMo 下可用。比赛演示前要切回 MiMo。
# STEPFUN_MODEL_PRO=step-5-preview
# STEPFUN_MODEL_FLASH=step-5-preview
# STEPFUN_MODEL_VISION=step-5-preview

# 确认联网搜索的费用后再打开。
MIMO_WEB_SEARCH=0

# 模型费用由赛事赞助时设为 1，经营台仍按标价显示，并标注赞助。
MODEL_COST_SPONSORED=0

# 选填：MiMo 故障时的备用模型，兼容 OpenAI 接口即可。经营台会显示实际使用的模型。
# FALLBACK_PROVIDER=
# FALLBACK_BASE_URL=
# FALLBACK_API_KEY=
# FALLBACK_MODEL=

# 选填：GitHub Issues 搜索用，提高频率限制。
# GITHUB_TOKEN=

# 选填：普通方式读不到页面时用 Playwright 渲染，需要先安装 Chromium。
READ_PAGE_BROWSER=0

# 验证页隐私说明里的联系方式。
PRIVACY_CONTACT=

# 部署用的域名和 Postgres 密码，只有 docker compose 会读取。密码只用字母和数字，它会被拼进连接地址。
DOMAIN=
POSTGRES_PASSWORD=

# 只在本机用 HTTP 运行生产构建时设为 0，线上不要设置。
# COOKIE_SECURE=0
