{
  "name": "firstcustomer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3100",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "worker": "tsx --env-file-if-exists=.env.local src/worker/index.ts",
    "db:dev": "tsx scripts/dev-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "seed:evidence": "tsx --env-file-if-exists=.env.local scripts/import-evidence.ts",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "library:build": "tsx --env-file-if-exists=.env.local scripts/build-library.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@mozilla/readability": "^0.6.0",
    "@vercel/queue": "0.11.0",
    "better-auth": "1.7.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "fuse.js": "^7.5.0",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "openai": "^7.50.0",
    "pg-boss": "^12.38.0",
    "playwright": "^1.64.1",
    "postgres": "^4.0.0",
    "rate-limiter-flexible": "^11.2.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
